{
  "compileOnSave": true,
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "removeComments": true,
    "sourceMap": false,
    "target": "es2015",
    "declaration": true,
    "types": [
      "drapo"
    ],
    "lib": [
      "dom",
      "es2015"
    ]
  },
  "include": [
    "wwwroot/components/**/*"
  ],
  "exclude": [
    "wwwroot/js/**/*"
  ]
}
