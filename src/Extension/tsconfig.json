{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": false,
    "lib": ["dom", "es2020"],
    "noEmitOnError": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "outDir": "dist",
    "removeComments": true,
    "rootDir": "src",
    "sourceMap": false,
    "strict": false,
    "strictFunctionTypes": true,
    "strictNullChecks": false,
    "target": "es2020",
    "types": []
  },
  "include": ["src/**/*.ts"]
}
